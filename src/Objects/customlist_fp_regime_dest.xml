      <isinactive>F</isinactive>
      <value>LR - Lucro Real</value>
    </customvalue>
    <customvalue scriptid="val_regime_dest_isento">
      <isinactive>F</isinactive>
      <value>ISENTO - Entidade isenta ou imune</value>
    </customvalue>
    <customvalue scriptid="val_regime_dest_pf">
      <isinactive>F</isinactive>
      <value>PF - Pessoa Fisica</value>
    </customvalue>
  </customvalues>
</customlist>
