<mapreducescript scriptid="customscript_fp_mr_obrigacoes">
  <description>Gera o CSV de uma obrigacao no layout da plataforma (contratos/importacao-csv). Disparado pela tela FP Obrigacoes.</description>
  <isinactive>F</isinactive>
  <name>FP Obrigacoes MR</name>
  <notifyadmins>F</notifyadmins>
  <notifyemails></notifyemails>
  <notifyowner>T</notifyowner>
  <notifyuser>F</notifyuser>
  <scriptfile>[/SuiteScripts/FiscalPlatform/fp_mr_obrigacoes.js]</scriptfile>
  <scriptcustomfields>
    <scriptcustomfield scriptid="custscript_fp_obr_arquivo">
      <accesslevel>2</accesslevel>
      <applyformatting>F</applyformatting>
      <checkspelling>F</checkspelling>
      <defaultchecked>F</defaultchecked>
      <defaultselection></defaultselection>
      <defaultvalue></defaultvalue>
      <description>O tipo do arquivo (PLANO_DE_CONTAS, ...), passado pela tela no disparo.</description>
      <displayheight></displayheight>
      <displaytype>NORMAL</displaytype>
      <displaywidth></displaywidth>
      <dynamicdefault></dynamicdefault>
      <fieldtype>TEXT</fieldtype>
      <help></help>
      <isformula>F</isformula>
      <ismandatory>F</ismandatory>
      <label>Arquivo</label>
      <linktext></linktext>
      <maxlength>60</maxlength>
      <maxvalue></maxvalue>
      <minvalue></minvalue>
      <setting></setting>
      <storevalue>T</storevalue>
    </scriptcustomfield>
    <scriptcustomfield scriptid="custscript_fp_obr_subsidiaria">
      <accesslevel>2</accesslevel>
      <applyformatting>F</applyformatting>
      <checkspelling>F</checkspelling>
      <defaultchecked>F</defaultchecked>
      <defaultselection></defaultselection>
      <defaultvalue></defaultvalue>
      <description>Internal id da subsidiaria: o arquivo e por subsidiaria porque a importacao da plataforma e por empresa.</description>
      <displayheight></displayheight>
      <displaytype>NORMAL</displaytype>
      <displaywidth></displaywidth>
      <dynamicdefault></dynamicdefault>
      <fieldtype>TEXT</fieldtype>
      <help></help>
      <isformula>F</isformula>
      <ismandatory>F</ismandatory>
      <label>Subsidiaria</label>
      <linktext></linktext>
      <maxlength>20</maxlength>
      <maxvalue></maxvalue>
      <minvalue></minvalue>
      <setting></setting>
      <storevalue>T</storevalue>
    </scriptcustomfield>
    <scriptcustomfield scriptid="custscript_fp_obr_competencia">
      <accesslevel>2</accesslevel>
      <applyformatting>F</applyformatting>
      <checkspelling>F</checkspelling>
      <defaultchecked>F</defaultchecked>
      <defaultselection></defaultselection>
      <defaultvalue></defaultvalue>
      <description>AAAA-MM, nos arquivos por competencia (lancamentos contabeis).</description>
      <displayheight></displayheight>
      <displaytype>NORMAL</displaytype>
      <displaywidth></displaywidth>
      <dynamicdefault></dynamicdefault>
      <fieldtype>TEXT</fieldtype>
      <help></help>
      <isformula>F</isformula>
      <ismandatory>F</ismandatory>
      <label>Competencia</label>
      <linktext></linktext>
      <maxlength>7</maxlength>
      <maxvalue></maxvalue>
      <minvalue></minvalue>
      <setting></setting>
      <storevalue>T</storevalue>
    </scriptcustomfield>
  </scriptcustomfields>
  <scriptdeployments>
    <scriptdeployment scriptid="customdeploy_fp_mr_obrigacoes">
      <buffersize>1</buffersize>
      <concurrencylimit>1</concurrencylimit>
      <isdeployed>T</isdeployed>
      <loglevel>DEBUG</loglevel>
      <queueallstagesatonce>T</queueallstagesatonce>
      <runasrole>ADMINISTRATOR</runasrole>
      <status>NOTSCHEDULED</status>
      <title>FP Obrigacoes MR</title>
    </scriptdeployment>
  </scriptdeployments>
</mapreducescript>
