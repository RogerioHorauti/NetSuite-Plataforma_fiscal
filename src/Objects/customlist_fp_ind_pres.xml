<customlist scriptid="customlist_fp_ind_pres">
  <description>indPres do grupo B da NF-e: presenca do comprador no estabelecimento. O CODIGO abre o valor e e o que vai no payload. Default da plataforma e 1 (presencial); so se declara quando a operacao nao e presencial.</description>
  <isinactive>F</isinactive>
  <isordered>T</isordered>
  <name>Presenca do Comprador</name>
  <customvalues>
    <customvalue scriptid="val_ind_pres_0"><isinactive>F</isinactive><value>0 - Nao se aplica (complementar ou ajuste)</value></customvalue>
    <customvalue scriptid="val_ind_pres_1"><isinactive>F</isinactive><value>1 - Operacao presencial</value></customvalue>
    <customvalue scriptid="val_ind_pres_2"><isinactive>F</isinactive><value>2 - Nao presencial, pela internet</value></customvalue>
    <customvalue scriptid="val_ind_pres_3"><isinactive>F</isinactive><value>3 - Nao presencial, teleatendimento</value></customvalue>
    <customvalue scriptid="val_ind_pres_4"><isinactive>F</isinactive><value>4 - NFC-e com entrega a domicilio</value></customvalue>
    <customvalue scriptid="val_ind_pres_5"><isinactive>F</isinactive><value>5 - Presencial fora do estabelecimento</value></customvalue>
    <customvalue scriptid="val_ind_pres_9"><isinactive>F</isinactive><value>9 - Nao presencial, outros</value></customvalue>
  </customvalues>
</customlist>
